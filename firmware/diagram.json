{
  "version": 1,
  "author": "Tim FishSlide",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": -20, "left": 230, "attrs": {} },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": 80, "left": 230, "attrs": {} },
    { "type": "wokwi-servo", "id": "servo1", "top": 200, "left": 230, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn_open", "top": 20, "left": -150, "attrs": { "color": "green" } },
    { "type": "wokwi-pushbutton", "id": "btn_close", "top": 100, "left": -150, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 200, "left": -150, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led1", "top": 260, "left": -140, "attrs": { "color": "yellow" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "pot1:VCC", "esp:3V3", "red", [] ],
    [ "pot1:GND", "esp:GND.1", "black", [] ],
    [ "pot1:SIG", "esp:D34", "green", [] ],

    [ "ldr1:VCC", "esp:3V3", "red", [] ],
    [ "ldr1:GND", "esp:GND.1", "black", [] ],
    [ "ldr1:AO", "esp:D35", "blue", [] ],

    [ "servo1:V+", "esp:VIN", "red", [] ],
    [ "servo1:GND", "esp:GND.2", "black", [] ],
    [ "servo1:PWM", "esp:D18", "orange", [] ],

    [ "btn_open:1.l", "esp:D25", "green", [] ],
    [ "btn_open:2.l", "esp:GND.1", "black", [] ],

    [ "btn_close:1.l", "esp:D26", "purple", [] ],
    [ "btn_close:2.l", "esp:GND.1", "black", [] ],

    [ "esp:D27", "r1:1", "orange", [] ],
    [ "r1:2", "led1:A", "orange", [] ],
    [ "led1:C", "esp:GND.2", "black", [] ]
  ]
}